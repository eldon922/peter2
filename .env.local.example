# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
#
# Optional since migration 041: it can now be entered per account in
# Settings → WhatsApp, below the webhook configuration, where it is
# stored encrypted. The stored value wins; this env var is the fallback
# and is still the simplest option for a single-tenant deployment.
# One of the two must be set — with neither, the webhook rejects
# every request.
META_APP_SECRET=your-meta-app-secret

# Instance-level webhook verify token — the string you type into
# "Verify token" when saving the callback URL on your Meta app.
#
# The per-account token entered in Settings → WhatsApp is still checked
# first and remains the right answer for a manual, single-tenant setup.
# This is for Embedded Signup, where the webhook is configured once on
# the Tech Provider's app rather than per customer, so there is no
# per-account row to match and the handshake would otherwise fail.
# Generate any long random string:
#   openssl rand -hex 32
# META_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-string

# Server log verbosity: debug | info | warn | error. Defaults to `info`,
# which records inbound webhooks, outbound sends and broadcast fan-out
# on stdout so `docker compose logs -f app` shows the app working rather
# than falling silent after startup. Set `warn` for errors only.
# LOG_LEVEL=info

# Email domain for user accounts. Only email addresses ending with
# this domain are allowed to register. You must create user accounts in
# Supabase with this domain.
USERNAME_EMAIL_DOMAIN=@your-domain.co

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash).
#
# Set this at BUILD time. It backs `metadataBase` in app/layout.tsx,
# which is what turns the social-preview tags (og:image, og:url) into
# absolute URLs. Most pages here are statically prerendered, so those
# tags are baked in when you build — there is no request to fall back
# on. Leave it unset and Next resolves them against
# http://localhost:3000, which scrapers cannot fetch, so link previews
# silently break. Docker builds need it as a build arg
# (docker-compose.yml already forwards it).
#
# Routes that need a self-referential URL at request time (invite
# links from /api/account/invitations) derive the origin from the
# incoming request instead, so for *those* it is only needed when the
# request-derived origin would be wrong — e.g. links generated from a
# cron job or background worker with no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Default language locale. One of the dictionaries in messages/:
#   en — English      ko — Korean       id — Bahasa Indonesia
# Anything else falls back to English. Note this is inlined into the
# client bundle at build time, so Docker builds need it as a build arg
# (docker-compose.yml already forwards it).
NEXT_PUBLIC_APP_LOCALE=en

# Whatsapp support link. Used for the "Need help?" link in the sidebar.
# Should be a wa.me link with your support number.
NEXT_PUBLIC_SUPPORT_WHATSAPP=https://wa.me/+6281234567890

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Numeric id of YOUR Facebook app. Emitted as the <meta
# property="fb:app_id"> tag, which Facebook's sharing debugger lists
# as a required property. Nothing breaks without it — link previews
# still render — but the debugger keeps reporting it as missing, and
# you get no Facebook domain insights or Social Plugin moderation.
#
# There is no shippable default: an app id identifies one specific
# Facebook app, so this template cannot supply one for your fork.
# Create an app at https://developers.facebook.com/apps and paste its
# id here. Inlined at build time, so Docker builds need it as a build
# arg. Left unset, the tag is simply omitted.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Meta Embedded Signup configuration ID (Meta for Developers → your app
# → WhatsApp → Embedded Signup → your configuration).
#
# Setting this — together with NEXT_PUBLIC_FACEBOOK_APP_ID, META_APP_ID
# and META_APP_SECRET — adds a "Connect with Facebook" button to
# Settings → WhatsApp, and collapses the manual credential form behind
# a disclosure. Customers then onboard in a pop-up instead of copying
# tokens, including connecting a number they already use in the
# WhatsApp Business app (coexistence).
#
# Most self-hosters should leave this unset. Embedded Signup requires an
# approved Meta **Tech Provider** app: business verification, App Review
# for whatsapp_business_management and whatsapp_business_messaging, and
# a configured signup flow. Without it, nothing changes — the manual
# form stays exactly as it is.
#
# For coexistence to sync messages sent from the Business app, also tick
# `smb_message_echoes` on your app's WhatsApp webhook fields.
#
# Inlined at build time, so Docker builds need it as a build arg.
# NEXT_PUBLIC_META_ES_CONFIG_ID=

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
#
# Also settable per account in Settings → WhatsApp (migration 041); the
# stored value wins and this stays as the fallback.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20
